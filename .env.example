# --- Models (all calls go through OpenRouter) ---
OPENROUTER_API_KEY=
# Hard cap on total model spend, tracked in .loandesk/spend.json. Also set a limit on the key itself.
LOANDESK_BUDGET_USD=10

# --- Rollback switches: change these two values to roll back ---
LOANDESK_PROMPT_VERSION=v1
LOANDESK_MODELS_CONFIG=config/models.yaml

# --- Data ---
LOANDESK_DATABASE_URL=postgresql+psycopg://loandesk:loandesk@localhost:5432/loandesk
# pgvector | qdrant | chroma | pinecone
LOANDESK_VECTOR_STORE=pgvector
LOANDESK_QDRANT_URL=http://localhost:6333
# "memory" runs Chroma in-process; otherwise host:port of the Chroma server
LOANDESK_CHROMA_URL=localhost:8001
LOANDESK_PINECONE_API_KEY=
LOANDESK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Memory: memory | postgres ---
LOANDESK_CHECKPOINTER=memory

# --- Integrations (leave Zendesk empty to use the local mock) ---
LOANDESK_ZENDESK_SUBDOMAIN=
LOANDESK_ZENDESK_EMAIL=
LOANDESK_ZENDESK_API_TOKEN=
LOANDESK_WEBHOOK_SECRET=change-me
# fixed: OTP is always 123456 (dev and evals only) | random
LOANDESK_OTP_MODE=fixed

# --- Admin console (OIDC). Leave JWKS empty to disable auth on localhost only ---
LOANDESK_ADMIN_JWKS_URL=
LOANDESK_ADMIN_AUDIENCE=
LOANDESK_ADMIN_ISSUER=
